rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function teacherReviewFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "feedback", "checklist", "requestedBy", "requestedByName",
        "requestedAt", "studentRead", "studentReadAt", "revisionRequestedAt",
        "revisionRequestedBy", "revisionRequestedByName", "revisionCount",
        "reviewedAt", "reviewedBy", "reviewedByName", "updatedAt", "lastSavedAt"
      ]);
    }

    function canRequestRevisionFromCurrentStatus() {
      return resource.data.status in [
        "submitted", "resubmitted", "revision_requested",
        "pending", "review_pending", "under_review",
        "returned", "revision", "revisionRequested", "rejected"
      ] && request.resource.data.status == "revision_requested";
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(["uid", "role"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "student";
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(["uid", "role"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /drafts/{draftId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          "ownerId", "ownerEmail", "projectId", "currentStep",
          "formData", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "draft";
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeacher());
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == "draft";
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeacher());
    }

    match /projects/{projectId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(["ownerId", "status", "currentStep"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "submitted"
        && !request.resource.data.keys().hasAny([
          "approvedAt", "approvedBy", "approvedByName",
          "teacherReview", "reviewHistory"
        ]);
      allow read: if isSignedIn() && (isOwner() || isTeacher());

      allow update: if isSignedIn() && (
        (
          isOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            (resource.data.status in ["draft", "writing"]
              && request.resource.data.status in ["draft", "submitted"])
            ||
            (resource.data.status in ["returned", "revision", "revisionRequested", "rejected", "revision_requested"]
              && request.resource.data.status in ["revision_requested", "resubmitted"])
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "projectName", "teamName", "members", "oneLineSummary",
            "expectedDuration", "currentStep", "progress", "planningData",
            "aiInteraction", "processLog", "status", "updatedAt",
            "submittedAt", "resubmittedAt", "resubmissionCount",
            "revisionInProgress", "revisionStartedAt"
          ])
        )
        ||
        (
          isOwner()
          && resource.data.status in ["returned", "revision", "revisionRequested", "rejected", "revision_requested"]
          && request.resource.data.status == resource.data.status
          && request.resource.data.studentRead == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "studentRead", "studentReadAt", "feedbackUnread", "revisionInProgress",
            "revisionStartedAt", "updatedAt"
          ])
        )
        ||
        (
          isTeacher()
          && canRequestRevisionFromCurrentStatus()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.reviewedBy.uid == request.auth.uid
          && request.resource.data.checklist is map
          && request.resource.data.checklist.keys().hasOnly([
            "problemDefinition", "goalAndCriteria", "hardwareFeasibility",
            "scheduleFeasibility", "safetyReview", "roleDistribution"
          ])
          && request.resource.data.checklist.problemDefinition is bool
          && request.resource.data.checklist.goalAndCriteria is bool
          && request.resource.data.checklist.hardwareFeasibility is bool
          && request.resource.data.checklist.scheduleFeasibility is bool
          && request.resource.data.checklist.safetyReview is bool
          && request.resource.data.checklist.roleDistribution is bool
          && request.resource.data.studentRead == false
          && request.resource.data.studentReadAt == null
          && teacherReviewFieldsOnly()
        )
        ||
        (
          isTeacher()
          && resource.data.status in ["submitted", "resubmitted"]
          && request.resource.data.status == "approved"
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "approvedAt", "approvedBy", "approvedByName", "updatedAt"
          ])
        )
      );

      allow delete: if isSignedIn() && (
        isTeacher() || (isOwner() && resource.data.status in ["draft", "writing", "in_progress", "작성 중"])
      );

      match /reviewHistory/{reviewId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isTeacher());
        allow create: if (isTeacher()
          && request.resource.data.action in ["revision_requested", "approved"]
          && request.resource.data.actorType == "teacher"
          && request.resource.data.actorId == request.auth.uid)
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
            && request.resource.data.action == "resubmitted"
            && request.resource.data.createdBy == request.auth.uid
          );
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if request.resource.data.recipientId is string
        && request.resource.data.projectId is string
        && request.resource.data.read == false
        && (
          (
            isTeacher()
            && request.resource.data.type in ["revision_requested", "project_approved"]
            && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
            && request.resource.data.recipientId
              == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId
          )
          ||
          (
            isSignedIn()
            && request.resource.data.type == "project_resubmitted"
            && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid
            && request.resource.data.recipientId
              == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.teacherReview.requestedBy
          )
        );
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.type == resource.data.type
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]);
      allow delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn() && request.auth.uid == teacherId;
      allow write: if false;
    }
  }
}
